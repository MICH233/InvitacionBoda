    <script>
        gsap.registerPlugin(ScrollTrigger);
        var IDS = ["fl", "pt", "fl", "pt", "fl"], COLS = ["#f7efe0", "#f3d9d4", "#c9506b", "#e8b4bc", "#d9bf8c"], fall = document.getElementById('fall'), H = innerHeight, NS = 'http://www.w3.org/2000/svg';
